{
  "name": "doctrack-server",
  "version": "1.0.0",
  "description": "DocTrack Healthcare Administration Standalone Express REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seeder.ts",
    "test:cases": "ts-node-dev --transpile-only src/test/run_8_test_cases.ts"
  },
  "keywords": [
    "doctrack",
    "express",
    "mongoose",
    "typescript",
    "healthcare"
  ],
  "author": "DocTrack Team",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
