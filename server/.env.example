# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS credentials transmission)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# Replace with your MongoDB Atlas connection string when ready:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/doctrack

# Supabase Authentication (Modern Key System)
# URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Public key for client/frontend usage
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key for server-side verification and admin tasks (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Development Flag (Set true to enable safe mock admin authentication for local testing)
DEV_MODE=true
