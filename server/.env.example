# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS credentials transmission)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# Replace with your MongoDB Atlas connection string when ready:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/doctrack

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Development Flag (Set true to bypass strict JWT check during local dev/testing)
DEV_MODE=true
