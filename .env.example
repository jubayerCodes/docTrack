# ==========================================
# DocTrack - Environment Variables Example
# ==========================================
# This file provides a template for both the backend (server/.env)
# and frontend (client/.env.local) configurations.

# ------------------------------------------
# 1. Backend Server Configuration (server/.env)
# ------------------------------------------
# Port for the Node.js / Express server
PORT=5000
NODE_ENV=development

# Allowed client origin for CORS and cookie transmission
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/doctrack
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doctrack?retryWrites=true&w=majority

# Supabase Authentication Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Development Mock Mode (Bypasses remote auth for local testing & automated suites)
DEV_MODE=true

# ------------------------------------------
# 2. Frontend Client Configuration (client/.env.local)
# ------------------------------------------
# Base URL for the Express REST API backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Supabase Auth Configuration for Next.js Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
